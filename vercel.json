{
  "version": 2,
  "builds": [
    { "src": "api/proxy.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "tester.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/proxy", "dest": "api/proxy.js" },
    { "src": "/tester.html", "dest": "tester.html" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}
